PORT=4000

#datos de conexion a mysql (xampp por defecto localhost)
#usuario=root y password vacio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gimnasio_bd

#texto secreto usado para firma el token jwt de sesion
#cambiarlo por cualquier cadena larga y unica en su proyecto
JWT_SECRET=clave_secreta_cuerso_inventario_react
JWT_EXPIRES_IN=8h

#datos del usuario administrador que crea npm  run seed
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_EMAIL=admin@gimnasio.com
SEED_ADMIN_PASSWORD=Admin123!