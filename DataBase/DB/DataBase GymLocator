-- =====================================================================
--  2. TABLA USUARIO  (aqui viven salt y hash; una cuenta por perfil)
--     Cada cuenta se enlaza a UN solo perfil segun su rol.
-- =====================================================================
CREATE TABLE Usuario (
  id_usuario        INT UNSIGNED NOT NULL AUTO_INCREMENT,
  nombre_usuario    VARCHAR(50)  NOT NULL,
  salt              CHAR(32)     NOT NULL,
  password_hash     CHAR(64)     NOT NULL,
  rol               ENUM('CLIENTE','ENTRENADOR','ADMIN') NOT NULL,
  id_cliente        INT UNSIGNED NULL,
  id_entrenador     INT UNSIGNED NULL,
  admin_id          INT UNSIGNED NULL,
  intentos_fallidos TINYINT UNSIGNED NOT NULL DEFAULT 0,
  bloqueado         BOOLEAN  NOT NULL DEFAULT FALSE,
  activo            BOOLEAN  NOT NULL DEFAULT TRUE,
  ultimo_acceso     DATETIME NULL,
  created_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id_usuario),
  UNIQUE KEY uq_usuario_nombre (nombre_usuario),
  UNIQUE KEY uq_usuario_cliente (id_cliente),
  UNIQUE KEY uq_usuario_entrenador (id_entrenador),
  UNIQUE KEY uq_usuario_admin (admin_id),
  CONSTRAINT fk_usuario_cliente FOREIGN KEY (id_cliente)
    REFERENCES Cliente (id_cliente),
  CONSTRAINT fk_usuario_entrenador FOREIGN KEY (id_entrenador)
    REFERENCES Entrenador (id_entrenador),
  CONSTRAINT fk_usuario_admin FOREIGN KEY (admin_id)
    REFERENCES Administrador (admin_id),
  CONSTRAINT chk_usuario_rol CHECK (
       (rol = 'CLIENTE'    AND id_cliente IS NOT NULL AND id_entrenador IS NULL AND admin_id IS NULL)
    OR (rol = 'ENTRENADOR' AND id_entrenador IS NOT NULL AND id_cliente IS NULL AND admin_id IS NULL)
    OR (rol = 'ADMIN'      AND admin_id IS NOT NULL AND id_cliente IS NULL AND id_entrenador IS NULL)
  )
) ENGINE=InnoDB;

-- =====================================================================
--  3. AUDITORIA  (nunca se guarda la contrasena ni el hash)
-- =====================================================================
CREATE TABLE auditoria_usuarios (
  id_auditoria INT UNSIGNED NOT NULL AUTO_INCREMENT,
  id_usuario   INT UNSIGNED NOT NULL,
  accion       VARCHAR(30)  NOT NULL,
  detalle      VARCHAR(255) NULL,
  usuario_db   VARCHAR(100) NOT NULL,
  fecha        DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id_auditoria),
  KEY idx_aud_usuario (id_usuario)
) ENGINE=InnoDB;

