-- =====================================================================
--  BASE DE DATOS: gimnasio_db   (XAMPP / MariaDB / MySQL)
--  Seguridad: hash + salt (SHA2), procedimientos de autenticacion,
--  auditoria con triggers, vistas que ocultan salt/hash y usuario
--  MySQL de minimo privilegio.
--  Importar desde phpMyAdmin > Importar.
-- =====================================================================

CREATE DATABASE IF NOT EXISTS gimnasio_db
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE gimnasio_db;

