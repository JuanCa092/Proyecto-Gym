-- =====================================================================
--  4. FUNCION: politica de contrasenas
--     minimo 8 caracteres, una mayuscula y un numero
-- =====================================================================
CREATE FUNCTION fn_password_valida(p_password VARCHAR(100))
RETURNS TINYINT(1)
DETERMINISTIC
BEGIN
  RETURN COALESCE(
    ( CHAR_LENGTH(p_password) >= 8
      AND CAST(p_password AS BINARY) <> CAST(LOWER(p_password) AS BINARY)
      AND p_password REGEXP '[0-9]' ), 0);
END //

-- =====================================================================
--  5. PROCEDIMIENTOS DE AUTENTICACION
--     La aplicacion NUNCA toca salt/hash: solo llama a estos.
-- =====================================================================

-- 5.1 Registrar usuario sobre un perfil que ya existe
CREATE PROCEDURE sp_registrar_usuario(
  IN p_nombre_usuario VARCHAR(50),
  IN p_password       VARCHAR(100),
  IN p_rol            VARCHAR(20),
  IN p_id_perfil      INT UNSIGNED
)
BEGIN
  DECLARE v_salt CHAR(32);

  DECLARE EXIT HANDLER FOR 1062
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'El nombre de usuario o el perfil ya tiene una cuenta';
  DECLARE EXIT HANDLER FOR 1452
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'El perfil indicado no existe';

  IF p_rol NOT IN ('CLIENTE','ENTRENADOR','ADMIN') THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Rol no valido';
  END IF;

  IF fn_password_valida(p_password) = 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'La contrasena debe tener minimo 8 caracteres, una mayuscula y un numero';
  END IF;

  -- salt aleatorio de 32 caracteres hexadecimales (compatible con MariaDB)
  SET v_salt = LEFT(SHA2(CONCAT(UUID(), RAND(), NOW(6)), 256), 32);

  INSERT INTO Usuario (nombre_usuario, salt, password_hash, rol,
                       id_cliente, id_entrenador, admin_id)
  VALUES (p_nombre_usuario,
          v_salt,
          SHA2(CONCAT(v_salt, p_password), 256),
          p_rol,
          IF(p_rol = 'CLIENTE',    p_id_perfil, NULL),
          IF(p_rol = 'ENTRENADOR', p_id_perfil, NULL),
          IF(p_rol = 'ADMIN',      p_id_perfil, NULL));
END //

-- 5.2 Registrar cliente completo (perfil + cuenta en una transaccion)
CREATE PROCEDURE sp_registrar_cliente(
  IN p_nom_cliente    VARCHAR(50),
  IN p_ape_cliente    VARCHAR(50),
  IN p_tipo_doc       VARCHAR(3),
  IN p_num_doc        VARCHAR(20),
  IN p_correo         VARCHAR(100),
  IN p_telefono       VARCHAR(15),
  IN p_nombre_usuario VARCHAR(50),
  IN p_password       VARCHAR(100)
)
BEGIN
  DECLARE EXIT HANDLER FOR SQLEXCEPTION
  BEGIN
    ROLLBACK;
    RESIGNAL;
  END;

  IF fn_password_valida(p_password) = 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'La contrasena debe tener minimo 8 caracteres, una mayuscula y un numero';
  END IF;

  START TRANSACTION;
    INSERT INTO Cliente (nom_cliente, ape_cliente, tipo_doc, num_doc, correo, telefono)
    VALUES (p_nom_cliente, p_ape_cliente, p_tipo_doc, p_num_doc, p_correo, p_telefono);

    CALL sp_registrar_usuario(p_nombre_usuario, p_password, 'CLIENTE', LAST_INSERT_ID());
  COMMIT;
END //

-- 5.3 Login: bloquea la cuenta tras 3 intentos fallidos
CREATE PROCEDURE sp_login(
  IN  p_nombre_usuario VARCHAR(50),
  IN  p_password       VARCHAR(100),
  OUT p_resultado      VARCHAR(100),
  OUT p_id_usuario     INT UNSIGNED,
  OUT p_rol            VARCHAR(20)
)
BEGIN
  DECLARE v_id        INT UNSIGNED DEFAULT NULL;
  DECLARE v_hash      CHAR(64);
  DECLARE v_salt      CHAR(32);
  DECLARE v_rol       VARCHAR(20);
  DECLARE v_bloqueado BOOLEAN;
  DECLARE v_intentos  INT;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET v_id = NULL;

  SET p_id_usuario = NULL;
  SET p_rol = NULL;

  SELECT id_usuario, password_hash, salt, bloqueado, intentos_fallidos, rol
    INTO v_id, v_hash, v_salt, v_bloqueado, v_intentos, v_rol
    FROM Usuario
   WHERE nombre_usuario = p_nombre_usuario AND activo = TRUE;

  IF v_id IS NULL THEN
    SET p_resultado = 'Usuario o contrasena incorrectos';

  ELSEIF v_bloqueado THEN
    SET p_resultado = 'Usuario bloqueado. Contacte al administrador';

  ELSEIF v_hash = SHA2(CONCAT(v_salt, p_password), 256) THEN
    UPDATE Usuario
       SET intentos_fallidos = 0, ultimo_acceso = NOW()
     WHERE id_usuario = v_id;
    SET p_id_usuario = v_id;
    SET p_rol = v_rol;
    SET p_resultado = 'Acceso concedido';

  ELSE
    UPDATE Usuario
       SET intentos_fallidos = v_intentos + 1,
           bloqueado = (v_intentos + 1 >= 3)
     WHERE id_usuario = v_id;
    SET p_resultado = 'Usuario o contrasena incorrectos';
  END IF;
END //

-- 5.4 Cambiar contrasena (genera un salt nuevo)
CREATE PROCEDURE sp_cambiar_password(
  IN  p_nombre_usuario   VARCHAR(50),
  IN  p_password_actual  VARCHAR(100),
  IN  p_password_nueva   VARCHAR(100),
  OUT p_resultado        VARCHAR(100)
)
BEGIN
  DECLARE v_salt_nuevo CHAR(32);

  IF NOT EXISTS (SELECT 1 FROM Usuario
                  WHERE nombre_usuario = p_nombre_usuario
                    AND activo = TRUE AND bloqueado = FALSE
                    AND password_hash = SHA2(CONCAT(salt, p_password_actual), 256)) THEN
    SET p_resultado = 'La contrasena actual no es correcta';

  ELSEIF fn_password_valida(p_password_nueva) = 0 THEN
    SET p_resultado = 'La nueva contrasena no cumple con la politica';

  ELSE
    SET v_salt_nuevo = LEFT(SHA2(CONCAT(UUID(), RAND(), NOW(6)), 256), 32);
    UPDATE Usuario
       SET salt = v_salt_nuevo,
           password_hash = SHA2(CONCAT(v_salt_nuevo, p_password_nueva), 256)
     WHERE nombre_usuario = p_nombre_usuario;
    SET p_resultado = 'Contrasena actualizada';
  END IF;
END //

-- 5.5 Desbloquear usuario (la app debe permitirlo solo a un ADMIN)
CREATE PROCEDURE sp_desbloquear_usuario(IN p_nombre_usuario VARCHAR(50))
BEGIN
  UPDATE Usuario
     SET bloqueado = FALSE, intentos_fallidos = 0
   WHERE nombre_usuario = p_nombre_usuario;
END //

-- =====================================================================
--  6. TRIGGERS DE AUDITORIA
-- =====================================================================
CREATE TRIGGER trg_usuario_ai
AFTER INSERT ON Usuario
FOR EACH ROW
BEGIN
  INSERT INTO auditoria_usuarios (id_usuario, accion, detalle, usuario_db)
  VALUES (NEW.id_usuario, 'REGISTRO', CONCAT('Cuenta creada con rol ', NEW.rol), CURRENT_USER());
END //

CREATE TRIGGER trg_usuario_au
AFTER UPDATE ON Usuario
FOR EACH ROW
BEGIN
  IF NEW.password_hash <> OLD.password_hash THEN
    INSERT INTO auditoria_usuarios (id_usuario, accion, detalle, usuario_db)
    VALUES (NEW.id_usuario, 'CAMBIO_PASSWORD', 'Se cambio la contrasena', CURRENT_USER());
  END IF;

  IF NEW.bloqueado = TRUE AND OLD.bloqueado = FALSE THEN
    INSERT INTO auditoria_usuarios (id_usuario, accion, detalle, usuario_db)
    VALUES (NEW.id_usuario, 'BLOQUEO', 'Bloqueado por intentos fallidos', CURRENT_USER());
  END IF;

  IF NEW.bloqueado = FALSE AND OLD.bloqueado = TRUE THEN
    INSERT INTO auditoria_usuarios (id_usuario, accion, detalle, usuario_db)
    VALUES (NEW.id_usuario, 'DESBLOQUEO', 'Usuario desbloqueado', CURRENT_USER());
  END IF;
END //

-- Trigger de cupo para las reservas de clases
CREATE TRIGGER trg_validar_cupo
BEFORE INSERT ON Cliente_Clase_entrenamiento
FOR EACH ROW
BEGIN
  DECLARE v_cupo SMALLINT UNSIGNED;
  DECLARE v_ocupados INT;

  SELECT num_cupo INTO v_cupo
    FROM Clase_entrenamiento WHERE id_clase_entr = NEW.id_clase_entr;

  SELECT COUNT(*) INTO v_ocupados
    FROM Cliente_Clase_entrenamiento
   WHERE id_clase_entr = NEW.id_clase_entr AND estado <> 'cancelada';

  IF v_ocupados >= v_cupo THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'La clase no tiene cupos disponibles';
  END IF;
END //

DELIMITER ;

-- =====================================================================
--  7. VISTAS: exponen la cuenta SIN salt ni hash
-- =====================================================================
CREATE VIEW vw_usuarios AS
SELECT id_usuario, nombre_usuario, rol,
       id_cliente, id_entrenador, admin_id,
       bloqueado, activo, ultimo_acceso, created_at
  FROM Usuario;

CREATE VIEW vw_usuarios_perfil AS
SELECT u.id_usuario,
       u.nombre_usuario,
       u.rol,
       COALESCE(CONCAT(c.nom_cliente, ' ', c.ape_cliente),
                CONCAT(e.nom_entrenador, ' ', e.ape_entrenador),
                CONCAT(a.nom_admin, ' ', a.apel_admin)) AS nombre_completo,
       COALESCE(c.correo, e.correo, a.correo)           AS correo,
       u.bloqueado,
       u.activo,
       u.ultimo_acceso
  FROM Usuario u
  LEFT JOIN Cliente       c ON c.id_cliente    = u.id_cliente
  LEFT JOIN Entrenador    e ON e.id_entrenador = u.id_entrenador
  LEFT JOIN Administrador a ON a.admin_id      = u.admin_id;

