  nom_entrenador      VARCHAR(50)  NOT NULL,
  ape_entrenador      VARCHAR(50)  NOT NULL,
  nom_especializacion VARCHAR(50)  NULL,
  tipo_doc            ENUM('CC','CE','TI','PAS','NIT') NOT NULL DEFAULT 'CC',
  num_doc             VARCHAR(20)  NOT NULL,
